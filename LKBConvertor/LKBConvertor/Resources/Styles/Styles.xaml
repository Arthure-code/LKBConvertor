<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Button" x:Key="btnPrincipal">
        <Setter Property="BackgroundColor" Value="{StaticResource BleuPrimaire}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style TargetType="Frame" x:Key="carteConversion">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style TargetType="Frame" x:Key="zoneSucces">
        <Setter Property="BackgroundColor" Value="{StaticResource VertSuccesClair}"/>
        <Setter Property="BorderColor" Value="{StaticResource VertSucces}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style TargetType="Frame" x:Key="zoneErreur">
        <Setter Property="BackgroundColor" Value="{StaticResource RougeErreurClair}"/>
        <Setter Property="BorderColor" Value="{StaticResource RougeErreur}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

</ResourceDictionary>